{
  "name": "cairn",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first, zero-cost, security-first tool for discovering and contributing to open source.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "libs/*",
    "apps/*"
  ],
  "scripts": {
    "prepare": "node scripts/setup-hooks.mjs",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/extension/tsconfig.json --noEmit && tsc -p api/optional-serverless/github-oauth/tsconfig.json --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "build:libs": "tsc -p tsconfig.build.json",
    "build:web": "npm run build --workspace @cairn/web",
    "build:extension": "npm run build --workspace @cairn/extension",
    "build": "npm run build:libs && npm run build:web && npm run build:extension",
    "guard:csp": "node scripts/check-csp.mjs",
    "guard:bundle-origins": "node scripts/check-bundle-origins.mjs",
    "guard": "npm run guard:csp && npm run guard:bundle-origins",
    "verify": "npm run format && npm run lint && npm run typecheck && npm run test && npm run guard:csp"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "globals": "^15.11.0",
    "prettier": "^3.3.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.44.0",
    "vitest": "^3.2.4"
  }
}
