{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [],
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@cairn/shared": ["libs/shared/src/index.ts"],
      "@cairn/auth": ["libs/auth/src/index.ts"],
      "@cairn/github": ["libs/github/src/index.ts"],
      "@cairn/profile": ["libs/profile/src/index.ts"],
      "@cairn/profile/testing": ["libs/profile/src/__fixtures__/build.ts"],
      "@cairn/zip": ["libs/zip/src/index.ts"],
      "@cairn/zip/testing": ["libs/zip/src/__fixtures__/build.ts"],
      "@cairn/cv-extract": ["libs/cv-extract/src/index.ts"],
      "@cairn/cv-extract/testing": ["libs/cv-extract/src/__fixtures__/build.ts"],
      "@cairn/doc-layout": ["libs/doc-layout/src/index.ts"],
      "@cairn/cv-parse": ["libs/cv-parse/src/index.ts"],
      "@cairn/linkedin-archive": ["libs/linkedin-archive/src/index.ts"],
      "@cairn/linkedin-archive/testing": [
        "libs/linkedin-archive/src/__fixtures__/build.ts"
      ],
      "@cairn/matching": ["libs/matching/src/index.ts"],
      "@cairn/discovery": ["libs/discovery/src/index.ts"],
      "@cairn/scoring": ["libs/scoring/src/index.ts"],
      "@cairn/repository-analysis": ["libs/repository-analysis/src/index.ts"],
      "@cairn/issue-analysis": ["libs/issue-analysis/src/index.ts"],
      "@cairn/portfolio": ["libs/portfolio/src/index.ts"],
      "@cairn/targets": ["libs/targets/src/index.ts"],
      "@cairn/ai": ["libs/ai/src/index.ts"]
    }
  }
}
